---
import '../styles/global.css';
import { site, nav, services, why, reviews, chips } from '../data/site.js';

// If there's no phone number yet, "Call" buttons go to the contact form.
const callHref = site.phone ? `tel:${site.phone}` : '#contact';
const canonical = new URL('/', Astro.site).href;
const ogImage = new URL(site.logo, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  name: site.name,
  url: canonical,
  image: ogImage,
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Langley', addressRegion: 'BC', addressCountry: 'CA' },
  areaServed: ['Langley', 'Lower Mainland'],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', bestRating: '5' },
  ...(site.phone ? { telephone: site.phone } : {}),
};

const heroDelay = (i) => `animation-delay:${(0.1 + i * 0.12).toFixed(2)}s`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{site.title}</title>
  <meta name="description" content={site.description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#0A1220" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={site.title} />
  <meta property="og:description" content={site.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_CA" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={site.title} />
  <meta name="twitter:description" content={site.description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <!-- Header -->
  <header id="top" class="header">
    <div class="wrap header__inner">
      <a href="#top" class="brand">
        <img src={site.logo} alt="Non Stop Plumbing & Heating" width="60" height="60" />
        <span class="brand__name">{site.shortName}<br class="brand__br" /><span class="brand__sub">{site.tagline}</span></span>
      </a>
      <nav class="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="header__right">
        <a href="#contact" class="btn btn--red header__cta">Book a plumber</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
          <span class="menu-btn__bars" aria-hidden="true"></span>
          <span class="sr-only">Menu</span>
        </button>
      </div>
    </div>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="hero">
      <svg class="pipes" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path d="M-20 120 H 900 V 640 H 1460" pathLength="1" stroke="#E8452C" style="animation-delay:.2s" />
        <path d="M-20 160 H 860 V 680 H 1460" pathLength="1" stroke="#1F8FDB" style="animation-delay:.45s" />
      </svg>
      <div class="wrap hero__inner">
        <div class="hero__copy">
          <p data-hero class="hero__rating" style={heroDelay(0)}>
            <span class="stars">★★★★★ 4.9 on HomeStars</span><span class="muted">Verified · Offers warranty</span>
          </p>
          <h1 data-hero class="hero__title" style={heroDelay(1)}>Hot water. Cold water. <span class="c-lightblue">Non stop.</span></h1>
          <p data-hero class="hero__lead" style={heroDelay(2)}>Reliable residential and commercial plumbing and heating in Langley and the Lower Mainland. Honest pricing, high-quality work, and a warranty on the job.</p>
          <div data-hero class="btn-row" style={heroDelay(3)}>
            <a href="#contact" class="btn btn--red btn--lg btn--hero">Book a plumber</a>
            <a href="#services" class="btn btn--outline btn--lg">What we fix</a>
          </div>
        </div>
        <div data-hero class="tiles" style={heroDelay(4)}>
          <div class="tile tile--red">
            <span class="tile__k">Heating</span>
            <strong class="tile__t">Boilers &amp; hot water tanks</strong>
          </div>
          <div class="tile tile--blue">
            <span class="tile__k">Plumbing</span>
            <strong class="tile__t">Leaks, fixtures &amp; renovations</strong>
          </div>
          <div class="tile-bar">
            <span>Residential &amp; commercial · Langley-based</span>
            <a href="#contact">Get a quote</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="services">
      <div class="wrap section">
        <div class="split-head">
          <h2 data-reveal class="h2">What we fix, fit and maintain.</h2>
          <p data-reveal class="lead-dark">From an urgent leak to a full renovation rough-in, one crew handles both sides of the job.</p>
        </div>
        <div class="svc-grid">
          {services.map((s) => (
            <article data-reveal class="svc">
              <span class={`svc__tag svc__tag--${s.tag}`}></span>
              <h3 class="h3">{s.t}</h3>
              <p>{s.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Why us -->
    <section id="why" class="wrap section why">
      <h2 data-reveal class="h2">Honest pricing. <span class="c-red">High quality.</span></h2>
      <div class="why__list">
        {why.map((w) => (
          <div data-reveal class="why__item">
            <h3 class="h3">{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Reviews -->
    <section id="reviews" class="reviews">
      <div class="wrap section">
        <div class="reviews__head">
          <h2 data-reveal class="h2">4.9 out of 5.</h2>
          <p data-reveal class="lead-light">Verified by HomeStars</p>
        </div>
        <div class="two-col reviews__grid">
          {reviews.map((r) => (
            <figure data-reveal class="review">
              {r.text ? (
                <>
                  <blockquote class="review__text">“{r.text}”</blockquote>
                  {(r.name || r.place) && <figcaption class="review__by">{[r.name, r.place].filter(Boolean).join(' · ')}</figcaption>}
                </>
              ) : (
                <div class="review__placeholder">HomeStars review coming soon</div>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="wrap section two-col contact">
      <div class="contact__info">
        <h2 data-reveal class="h2 h2--xl">Tell us what’s leaking.</h2>
        <p data-reveal class="lead-light">Send a few details and a photo if you have one. We’ll call you back with next steps and an honest price.</p>
        <a data-reveal href={callHref} class="contact__phone">{site.phoneDisplay}</a>
        <p data-reveal class="contact__meta">{site.area} · Serving the Lower Mainland<br />Company no. {site.companyNumber}</p>
      </div>
      <div>
        <form data-reveal class="form" id="contact-form" data-endpoint={site.formEndpoint}>
          <div class="form__row">
            <label>Name<input name="name" required autocomplete="name" /></label>
            <label>Phone<input name="phone" type="tel" required autocomplete="tel" /></label>
          </div>
          <fieldset class="form__chips">
            <legend>What do you need?</legend>
            <div class="chips">
              {chips.map((c) => <button type="button" class="chip" aria-pressed="false" data-value={c}>{c}</button>)}
            </div>
            <input type="hidden" name="needs" value="" />
          </fieldset>
          <label>Details<textarea name="details" rows="4"></textarea></label>
          <p class="form__error" role="alert" hidden>Sorry, something went wrong. Please try again.</p>
          <button type="submit" class="btn btn--red btn--lg form__submit">Request a callback</button>
        </form>
        <div class="form-thanks" role="status" hidden>Got it. We’ll call you back shortly.</div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="wrap footer__inner">
      <img src={site.logo} alt="Non Stop Plumbing & Heating" width="56" height="56" loading="lazy" />
      <span>{site.area} · Residential &amp; commercial</span>
      <div class="footer__legal">
        <span>© 2026 {site.name}</span>
        <a href={site.backpackUrl} target="_blank" rel="noopener">Website by Backpack Digital Media</a>
      </div>
    </div>
  </footer>

  <!-- Sticky bottom bar (small screens only) -->
  <div class="bottom-bar">
    <a href={callHref} class="bottom-bar__call">Call</a>
    <a href="#contact" class="bottom-bar__book">Book</a>
  </div>

  <script>
    // Menu button (small screens)
    const menuBtn = document.querySelector('.menu-btn');
    const menu = document.getElementById('mobile-menu');
    const setMenu = (open) => {
      menuBtn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    menuBtn.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

    // Scroll reveal
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealEls = document.querySelectorAll('[data-reveal]');
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        let i = 0;
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.style.setProperty('--d', `${Math.min(i++, 5) * 0.08}s`);
          e.target.classList.remove('is-hidden');
          io.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -8% 0px' });
      revealEls.forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight) return;
        el.classList.add('is-hidden');
        io.observe(el);
      });
      // Safety net: show everything after 4 seconds no matter what.
      setTimeout(() => revealEls.forEach((el) => el.classList.remove('is-hidden')), 4000);
    }

    // Form chips
    const form = document.getElementById('contact-form');
    const needs = form.querySelector('input[name="needs"]');
    const chipBtns = form.querySelectorAll('.chip');
    chipBtns.forEach((btn) => btn.addEventListener('click', () => {
      btn.setAttribute('aria-pressed', btn.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      needs.value = [...chipBtns].filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.value).join(', ');
    }));

    // Form submit
    const thanks = document.querySelector('.form-thanks');
    const errorMsg = form.querySelector('.form__error');
    const submitBtn = form.querySelector('.form__submit');
    const showThanks = () => { form.hidden = true; thanks.hidden = false; };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.hidden = true;
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        console.warn('No formEndpoint set in src/data/site.js, so this message was not sent.');
        showThanks();
        return;
      }
      submitBtn.disabled = true;
      try {
        const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        showThanks();
      } catch (err) {
        errorMsg.hidden = false;
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</body>
</html>

<style>
  /* Header */
  .header { position: sticky; top: 0; z-index: 50; background: var(--navy); border-bottom: 1px solid var(--rule); }
  .header__inner { height: 84px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; }
  .brand img { height: 60px; width: 60px; object-fit: cover; display: block; }
  .brand__name { font-family: var(--font-head); font-weight: 800; font-size: 20px; color: var(--light); line-height: 1.05; }
  .brand__sub { font-weight: 600; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .nav { display: flex; gap: 32px; font-family: var(--font-head); font-weight: 600; font-size: 16px; }
  .nav a { color: var(--light); text-decoration: none; }
  .nav a:hover { color: var(--light-blue); }
  .header__right { display: flex; align-items: center; gap: 10px; }

  .menu-btn { display: none; width: 48px; height: 48px; background: transparent; border: 1.5px solid var(--rule); color: var(--light); cursor: pointer; align-items: center; justify-content: center; }
  .menu-btn__bars, .menu-btn__bars::before, .menu-btn__bars::after { display: block; width: 20px; height: 2px; background: currentColor; position: relative; content: ''; }
  .menu-btn__bars::before { position: absolute; top: -6px; }
  .menu-btn__bars::after { position: absolute; top: 6px; }
  .mobile-menu { border-top: 1px solid var(--rule); background: var(--navy); display: flex; flex-direction: column; padding: 8px var(--gutter) 16px; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a { color: var(--light); text-decoration: none; font-family: var(--font-head); font-weight: 600; font-size: 18px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .mobile-menu a:hover { color: var(--light-blue); }

  /* Buttons */
  .btn { display: inline-block; text-decoration: none; font-family: var(--font-head); font-weight: 700; font-size: 16px; padding: 14px 22px; white-space: nowrap; border: none; cursor: pointer; }
  .btn--lg { font-size: 18px; padding: 18px 28px; }
  .btn--red { background: var(--red); color: var(--white); }
  .btn--red:hover { background: var(--blue); color: var(--white); }
  .btn--hero:hover { background: var(--white); color: var(--navy); }
  .btn--outline { border: 2px solid var(--light-blue); color: var(--light); padding: 16px 26px; }
  .btn--outline:hover { background: var(--light-blue); color: var(--navy); }
  .btn-row { display: flex; flex-wrap: wrap; gap: 12px; }

  .c-lightblue { color: var(--light-blue); }
  .c-red { color: var(--red); }
  .muted { color: var(--muted); }

  /* Hero */
  .hero { position: relative; overflow: hidden; }
  .pipes { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .22; pointer-events: none; }
  .pipes path { fill: none; stroke-width: 10; stroke-linecap: square; stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(.js) .pipes path { stroke-dashoffset: 1; animation: nsFlow 2.4s cubic-bezier(.65,0,.35,1) forwards; }
  .hero__inner { position: relative; padding-top: clamp(64px, 8vw, 130px); padding-bottom: clamp(72px, 9vw, 140px); display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 40px 72px; align-items: center; }
  .hero__copy { display: flex; flex-direction: column; gap: 26px; }
  .hero__rating { display: flex; flex-wrap: wrap; gap: 8px 18px; font-family: var(--font-head); font-weight: 600; font-size: 15px; }
  .stars { color: var(--star); }
  .hero__title { font-family: var(--font-head); font-weight: 800; font-size: clamp(50px, 6.8vw, 116px); line-height: .92; letter-spacing: -.045em; }
  .hero__lead { max-width: 31em; font-size: clamp(19px, 1.4vw, 21px); color: var(--text-dark-bg); }
  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .tile { color: var(--white); padding: clamp(22px, 2.4vw, 32px); display: flex; flex-direction: column; gap: 8px; aspect-ratio: 1 / 1; justify-content: flex-end; }
  .tile--red { background: var(--red); }
  .tile--blue { background: var(--blue); }
  .tile__k { font-family: var(--font-head); font-weight: 700; font-size: 14px; letter-spacing: .14em; text-transform: uppercase; }
  .tile__t { font-family: var(--font-head); font-weight: 800; font-size: clamp(24px, 2.2vw, 32px); line-height: 1.05; letter-spacing: -.02em; }
  .tile-bar { grid-column: span 2; background: var(--raised); border: 1px solid var(--rule); padding: clamp(20px, 2.2vw, 28px); display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .tile-bar span { font-size: 17px; color: var(--text-dark-bg); }
  .tile-bar a { font-family: var(--font-head); font-weight: 700; font-size: 17px; color: var(--light-blue); }
  .tile-bar a:hover { color: var(--white); }

  /* Shared section bits */
  .section { padding-top: var(--section-pad); padding-bottom: var(--section-pad); }
  .h2 { font-family: var(--font-head); font-weight: 800; font-size: clamp(42px, 5vw, 84px); line-height: .95; letter-spacing: -.045em; }
  .h2--xl { font-size: clamp(46px, 5.6vw, 96px); line-height: .92; }
  .h3 { font-family: var(--font-head); font-weight: 700; font-size: clamp(22px, 1.9vw, 28px); letter-spacing: -.02em; line-height: 1.1; }
  .lead-dark { font-size: 19px; color: var(--text-light-bg); max-width: 30em; }
  .lead-light { font-size: 19px; color: var(--text-dark-bg); max-width: 28em; }
  .two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }

  /* Services */
  .services { background: var(--light); color: var(--navy); }
  .split-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px 80px; align-items: end; margin-bottom: clamp(32px, 4vw, 52px); }
  .svc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; background: var(--card-rule); border: 2px solid var(--card-rule); }
  .svc { background: var(--white); padding: clamp(24px, 2.6vw, 36px); display: flex; flex-direction: column; gap: 12px; }
  .svc p { font-size: 17px; color: var(--text-light-bg); }
  .svc__tag { width: 36px; height: 6px; display: block; }
  .svc__tag--red { background: var(--red); }
  .svc__tag--blue { background: var(--blue); }

  /* Why us */
  .why { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px 96px; align-items: start; }
  .why__list { display: flex; flex-direction: column; }
  .why__item { border-top: 1px solid var(--rule); padding: 24px 0 30px; display: flex; flex-direction: column; gap: 8px; }
  .why__item .h3 { line-height: 1.6; }
  .why__item p { font-size: 18px; color: var(--text-dark-bg); }

  /* Reviews */
  .reviews { background: var(--raised); }
  .reviews__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: clamp(32px, 4vw, 52px); }
  .reviews__head .lead-light { font-size: 18px; }
  .reviews__grid { gap: clamp(24px, 3vw, 44px); }
  .review { border-top: 3px solid var(--light-blue); padding-top: 22px; display: flex; flex-direction: column; gap: 16px; }
  .review__text { margin: 0; font-size: clamp(19px, 1.4vw, 21px); color: var(--light); }
  .review__by { font-family: var(--font-head); font-weight: 600; font-size: 15px; color: var(--muted); }
  .review__placeholder { height: 120px; display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px; border: 1.5px dashed var(--rule); color: var(--muted); font-family: var(--font-head); font-weight: 600; font-size: 15px; }

  /* Contact */
  .contact { gap: 48px 88px; align-items: start; }
  .contact__info { display: flex; flex-direction: column; gap: 22px; }
  .contact__phone { color: var(--white); text-decoration: none; font-family: var(--font-head); font-weight: 800; font-size: clamp(38px, 4.2vw, 66px); letter-spacing: -.04em; line-height: 1; }
  .contact__phone:hover { color: var(--light-blue); }
  .contact__meta { font-size: 17px; color: var(--muted); border-top: 1px solid var(--rule); padding-top: 18px; }

  .form { background: var(--light); color: var(--navy); padding: clamp(26px, 3vw, 44px); display: flex; flex-direction: column; gap: 18px; }
  .form[hidden] { display: none; }
  .form label, .form legend { display: flex; flex-direction: column; gap: 7px; font-family: var(--font-head); font-weight: 600; font-size: 15px; }
  .form input, .form textarea { border: 1.5px solid var(--input-rule); background: var(--white); padding: 14px; font-family: var(--font-body); font-size: 18px; color: var(--navy); border-radius: 0; }
  .form textarea { resize: vertical; }
  .form__row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 16px; }
  .form__chips { border: 0; padding: 0; margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .form__chips legend { padding: 0; margin-bottom: 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { border: 1.5px solid var(--navy); background: transparent; color: var(--navy); font-family: var(--font-head); font-weight: 600; font-size: 15px; padding: 10px 14px; cursor: pointer; }
  .chip[aria-pressed='true'] { background: var(--navy); color: var(--white); }
  .form__submit { align-self: flex-start; padding: 18px 30px; }
  .form__submit:hover { background: var(--navy); }
  .form__submit:disabled { opacity: .6; cursor: wait; }
  .form__error { color: #B3261E; font-weight: 600; font-size: 16px; }
  .form__error[hidden] { display: none; }
  .form-thanks { background: var(--light); color: var(--navy); padding: clamp(28px, 3vw, 48px); font-family: var(--font-head); font-weight: 800; font-size: clamp(28px, 2.6vw, 40px); letter-spacing: -.03em; line-height: 1.1; }
  .form-thanks[hidden] { display: none; }

  /* Footer */
  .footer { background: var(--footer); color: var(--muted); }
  .footer__inner { padding-top: 40px; padding-bottom: 40px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 18px 40px; font-size: 15px; }
  .footer__inner img { height: 56px; width: 56px; object-fit: cover; display: block; }
  .footer__legal { display: flex; flex-direction: column; gap: 4px; }
  .footer__legal a { color: var(--muted); }
  .footer__legal a:hover { color: var(--white); }

  /* Bottom bar */
  .bottom-bar { display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; grid-template-columns: 1fr 1fr; }
  .bottom-bar a { color: var(--white); text-decoration: none; font-family: var(--font-head); font-weight: 700; font-size: 17px; padding: 18px; text-align: center; }
  .bottom-bar__call { background: var(--blue); }
